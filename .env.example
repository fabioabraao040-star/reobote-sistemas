# Servidor
PORT=3000
APP_URL="http://localhost:3000"

# Gemini AI (se necessário para respostas inteligentes)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WhatsApp Business Cloud API (Meta Oficial)
# As credenciais são gerenciadas e armazenadas exclusivamente no backend
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="reobote_webhook_secret_token"
WHATSAPP_PHONE_NUMBER=""
# App Secret da Meta para validação de assinatura do webhook
WHATSAPP_APP_SECRET=""

# Supabase (Banco de Dados PostgreSQL & Autenticação Real)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Integração servidor a servidor com o REOBOTE SUPORTE (monitoramento)
# Gere um valor exclusivo com: openssl rand -hex 32
# NUNCA versione o valor real. Configure o MESMO valor no REOBOTE SUPORTE.
REOBOTE_MONITORING_SECRET=
